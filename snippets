              }
            }
          }

          if (url.pathname.toLowerCase().includes(`/${authToken}`)) {
            return await handleSubscriptionRequest(request, authToken);
          }
        }
      }
      return new Response('Not Found', { status: 404 });
    } catch (err) {
      return new Response(err.toString(), { status: 500 });
    }
  },
};

